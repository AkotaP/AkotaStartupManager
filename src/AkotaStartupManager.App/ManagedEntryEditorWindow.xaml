<Window x:Class="AkotaStartupManager.App.ManagedEntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑接管启动规则" Width="780" Height="700" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="接管启动规则" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="配置目标程序、稳定性策略以及可嵌套的 AND / OR 就绪条件。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="程序路径" Margin="0,8,0,0"/><TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="参数" Margin="0,8,0,0"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="工作目录" Margin="0,8,0,0"/><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                <UniformGrid Columns="5" Margin="0,14,0,8">
                    <StackPanel Margin="4"><TextBlock Text="轮询秒数"/><TextBox Text="{Binding PollIntervalSeconds}"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock Text="连续次数"/><TextBox Text="{Binding RequiredConsecutiveSuccesses}"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock Text="就绪延时"/><TextBox Text="{Binding DelayAfterReadySeconds}"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock Text="验证秒数"/><TextBox Text="{Binding StartupVerificationSeconds}"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock Text="最多尝试"/><TextBox Text="{Binding MaxRetries}"/></StackPanel>
                </UniformGrid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="条件表达式树" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="选择一个条件组后可添加子条件或嵌套组；选择叶条件后可编辑参数。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"/>
                        <TreeView x:Name="ConditionTree" MinHeight="180" SelectedItemChanged="ConditionTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:ConditionGroup}" ItemsSource="{Binding Children}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Padding="4"/>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type local:ProcessCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                                <DataTemplate DataType="{x:Type local:TcpPortCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                                <DataTemplate DataType="{x:Type local:HttpCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                                <DataTemplate DataType="{x:Type local:FileExistsCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                                <DataTemplate DataType="{x:Type local:WindowsServiceCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                                <DataTemplate DataType="{x:Type local:WindowTitleCondition}" xmlns:local="clr-namespace:AkotaStartupManager.Core.Models.Conditions;assembly=AkotaStartupManager.Core"><TextBlock Text="{Binding DisplayName}" Padding="4"/></DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ AND 组" Click="AddAndGroup_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ OR 组" Click="AddOrGroup_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ 进程" Click="AddProcess_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ TCP" Click="AddTcp_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ HTTP" Click="AddHttp_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ 文件" Click="AddFile_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ 服务" Click="AddService_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ 窗口" Click="AddWindow_Click"/>
                            <Button Background="#FFB3261E" Content="删除" Click="RemoveCondition_Click"/>
                        </WrapPanel>
                        <Border x:Name="PropertyPanel" Background="#FFF7F5FC" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="PropertyTitle" Text="条件参数" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Field1Label" VerticalAlignment="Center"/><TextBox x:Name="Field1Text" Grid.Column="1" TextChanged="ConditionField_Changed"/>
                                </Grid>
                                <Grid x:Name="Field2Row"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Field2Label" VerticalAlignment="Center"/><TextBox x:Name="Field2Text" Grid.Column="1" TextChanged="ConditionField_Changed"/>
                                </Grid>
                                <CheckBox x:Name="RegexCheck" Content="使用正则表达式" Checked="ConditionField_Changed" Unchecked="ConditionField_Changed" Visibility="Collapsed" Margin="4,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="Cancel_Click"/><Button Content="保存规则" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
