<Window x:Class="AkotaStartupManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Icon="Resources/app.ico" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="20,24,16,16">
                    <Border Width="52" Height="52" CornerRadius="12" Background="#FFF5F9FF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True">
                        <Image Source="Resources/icon.png" Stretch="Uniform" Margin="3" />
                    </Border>
                    <TextBlock Text="Akota Startup" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="Manager" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavigationButton}" Content="⌂  概览" GroupName="Nav" IsChecked="True" Checked="Navigation_Checked" Tag="0" />
                    <RadioButton Style="{StaticResource NavigationButton}" Content="▦  Windows 启动项" GroupName="Nav" Checked="Navigation_Checked" Tag="1" />
                    <RadioButton Style="{StaticResource NavigationButton}" Content="▶  接管启动" GroupName="Nav" Checked="Navigation_Checked" Tag="2" />
                    <RadioButton Style="{StaticResource NavigationButton}" Content="≡  运行日志" GroupName="Nav" Checked="Navigation_Checked" Tag="3" />
                    <RadioButton Style="{StaticResource NavigationButton}" Content="⚙  设置" GroupName="Nav" Checked="Navigation_Checked" Tag="4" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12">
                    <StackPanel><TextBlock Text="当前状态" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="26">
            <TabControl x:Name="Pages" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="概览" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="管理 Windows 启动行为，让应用按可靠的依赖条件启动。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="原生启动项" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StartupItemCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="接管规则" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ManagedCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="正在运行" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RunningCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="6,18,6,6"><StackPanel><TextBlock Text="运行状态" FontSize="18" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding RuntimeStates}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="连续满足" Binding="{Binding ConsecutiveSuccesses}" Width="90"/><DataGridTextColumn Header="尝试" Binding="{Binding Attempt}" Width="70"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Windows 启动项" FontSize="30" FontWeight="SemiBold"/><DockPanel Margin="0,14,0,12"><TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称或路径搜索" DockPanel.Dock="Left"/><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="接管启动" Command="{Binding TakeOverCommand}"/><Button Content="禁用并备份" Command="{Binding DisableCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="{Binding BackupCountText}" Command="{Binding OpenBackupsCommand}"/></DockPanel></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding StartupItems}" SelectedItem="{Binding SelectedStartupItem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="来源" Binding="{Binding SourceType}" Width="120"/><DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="100"/><DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*"/></DataGrid.Columns></DataGrid></Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="接管启动" FontSize="30" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,12"><Button Content="添加规则" Command="{Binding AddManagedCommand}"/><Button Content="编辑规则" Command="{Binding EditManagedCommand}"/><Button Content="立即启动" Command="{Binding LaunchNowCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="重新监控" Command="{Binding RestartMonitoringCommand}"/><Button Background="#FFB3261E" Content="删除规则" Command="{Binding RemoveManagedCommand}"/></WrapPanel></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid x:Name="ManagedEntriesGrid" ItemsSource="{Binding ManagedEntries}" SelectedItem="{Binding SelectedManagedEntry}" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0" MouseDoubleClick="ManagedEntriesGrid_MouseDoubleClick"><DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="65" SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="勾选后规则参与监控；取消勾选会立即停止该规则的监控" Click="ManagedEntryEnabled_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="程序" Binding="{Binding ExecutablePath}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="轮询" Binding="{Binding PollIntervalSeconds, StringFormat={}{0} 秒}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="连续" Binding="{Binding RequiredConsecutiveSuccesses}" Width="65" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="运行日志" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="只在状态变化和关键动作时记录，避免轮询刷屏。" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Right"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="6,20,6,6"><ListBox ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono, Consolas" BorderThickness="0"/></Border></Grid>
                </TabItem>
                <TabItem>
                    <StackPanel><TextBlock Text="设置" FontSize="30" FontWeight="SemiBold"/><Border Style="{StaticResource Card}" Margin="6,20,6,6"><StackPanel><CheckBox Content="随 Windows 启动（后台托盘）" IsChecked="{Binding StartWithWindows}" FontSize="16" Margin="0,4,0,12"/><TextBlock Text="配置、备份和日志保存在程序自身目录。系统级注册表和计划任务操作需要管理员权限。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Button Style="{StaticResource SecondaryButton}" Content="打开日志目录" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
